{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "window-host-capability",
  "description": "Capability for popped-out window-host windows.",
  "windows": ["window-host-*"],
  "local": true,
  "permissions": [
    "core:window:default",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:event:allow-emit",
    "allow-window-close",
    "allow-window-host-get-record",
    "allow-window-host-pop-in",
    "allow-window-host-discard"
  ]
}
