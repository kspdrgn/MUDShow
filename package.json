{
  "name": "mudshow",
  "version": "1.0.0",
  "description": "MUDShow!",
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "start": "npm run tauri:dev",
    "tauri:dev": "node scripts/tauri-dev.mjs",
    "tauri:build": "tauri build",
    "build": "npm run tauri:build",
    "build:frontend": "vite build --config frontend/vite.config.ts",
    "dev:frontend": "vite dev --config frontend/vite.config.ts",
    "clean": "rimraf dist tauri/target tauri/.mudshow-tauri-dev-*.json",
    "test:surface-protocol": "node node_modules/typescript/lib/tsc.js -p frontend/src/lib/tsconfig.surface-tests.json && node --test dist/surface-tests/lib/tests/surface-protocol.test.js",
    "test": "npm run test:surface-protocol"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tauri-apps/cli": "^2.11.2",
    "@types/node": "^26.0.0",
    "rimraf": "^6.1.3",
    "svelte": "^5.56.3",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  }
}
